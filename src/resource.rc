#include "resource.h"
#include <windows.h>
#include <commctrl.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Application Icon
IDI_APP_ICON ICON "app.ico"

// Main Dialog
IDD_MAIN_DIALOG DIALOGEX 0, 0, 470, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Audio Thread Isolator v1.0.4"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "", IDC_LIST_PROCESSES, "SysListView32", 
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_CLIPSIBLINGS, 
                    6, 6, 404, 82

    CONTROL         "Always on Top", IDC_CHK_ALWAYS_ON_TOP, "Button", 
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_CLIPSIBLINGS, 415, 6, 65, 9

    PUSHBUTTON      "&Edit", IDC_BTN_EDIT, 420, 24, 52, 10, WS_CLIPSIBLINGS
    PUSHBUTTON      "&Add", IDC_BTN_ADD, 420, 36, 52, 10, WS_CLIPSIBLINGS
    PUSHBUTTON      "&Remove", IDC_BTN_REMOVE, 420, 48, 52, 10, WS_CLIPSIBLINGS
    
    PUSHBUTTON      "&Settings", IDC_BTN_SETTINGS, 420, 72, 52, 10, WS_CLIPSIBLINGS

    PUSHBUTTON      "E&xit", IDC_BTN_EXIT, 420, 96, 52, 10, WS_CLIPSIBLINGS
END


// Process Picker Dialog
IDD_PROCESS_PICKER DIALOGEX 0, 0, 340, 290
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "Select Process"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Check the processes you want to monitor and isolate:", -1, 7, 7, 326, 12
    CONTROL         "", IDC_LIST_RUNNING, "SysListView32", 
                    LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 
                    7, 22, 326, 238
    PUSHBUTTON      "&Refresh", IDC_BTN_REFRESH, 7, 266, 55, 17
    DEFPUSHBUTTON   "Done", IDC_BTN_SELECT_DONE, 215, 266, 55, 17
    PUSHBUTTON      "Cancel", IDC_BTN_SELECT_CANCEL, 275, 266, 58, 17
END

// Global Settings Dialog
IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 320, 170
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_VISIBLE
CAPTION "Global Settings"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "", IDC_LIST_SETTINGS_CORES, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,
                    12, 10, 296, 40

    LTEXT           "Default Audio Core (Mask):", -1, 14, 59, 106, 10
    EDITTEXT        IDC_EDIT_AUDIO_CORE, 122, 57, 24, 12, ES_AUTOHSCROLL | ES_CENTER
    LTEXT           "<- Except this: Apply mask", IDC_STATIC_EXCLUDE_DESC, 150, 55, 120, 8
    RTEXT           "to ALL unlisted processes ->", IDC_STATIC_EXCLUDE_DESC2, 150, 64, 120, 8
    PUSHBUTTON      "Apply", IDC_BTN_APPLY_EXCLUDE_CORE, 274, 54, 34, 18, WS_TABSTOP

    LTEXT           "Excluded (Mask):", -1, 14, 80, 106, 10
    EDITTEXT        IDC_EDIT_NORMAL_CORES, 122, 78, 24, 12, ES_AUTOHSCROLL | ES_CENTER
    LTEXT           "<- Apply this mask", IDC_STATIC_NORMAL_DESC, 150, 76, 120, 8
    RTEXT           "to ALL unlisted processes ->", IDC_STATIC_NORMAL_DESC2, 150, 85, 120, 8
    PUSHBUTTON      "Apply", IDC_BTN_APPLY_NORMAL_MASK, 274, 75, 34, 18, WS_TABSTOP

    LTEXT           "Audio Thread Priority:", -1, 14, 102, 106, 10
    COMBOBOX        IDC_COMBO_AUDIO_PRIORITY, 122, 100, 85, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Polling Interval (ms):", -1, 14, 122, 106, 10
    EDITTEXT        IDC_EDIT_POLLING_MS, 122, 120, 24, 12, ES_AUTOHSCROLL | ES_NUMBER | ES_CENTER

    CONTROL         "Release Mask", IDC_BTN_RELEASE_MASK, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED, 12, 146, 62, 15
    DEFPUSHBUTTON   "OK", IDC_BTN_SETTINGS_OK, 216, 146, 45, 15
    PUSHBUTTON      "Cancel", IDC_BTN_SETTINGS_CANCEL, 265, 146, 45, 15
END

// Process Rule Edit Dialog
IDD_RULE_EDIT_DIALOG DIALOGEX 0, 0, 280, 176
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_VISIBLE
CAPTION "Thread Isolation Settings"

FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Target Process:", -1, 14, 10, 65, 10
    LTEXT           "", IDC_STATIC_PROCESS_NAME, 85, 10, 180, 10

    CONTROL         "", IDC_LIST_RULE_CORES, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,
                    12, 22, 256, 40

    LTEXT           "Audio Core (Mask):", -1, 14, 70, 106, 10
    EDITTEXT        IDC_EDIT_RULE_CORE, 122, 68, 50, 12, ES_AUTOHSCROLL | ES_CENTER

    LTEXT           "Excluded (Mask):", -1, 14, 88, 106, 10
    EDITTEXT        IDC_EDIT_RULE_NORMAL_CORES, 122, 86, 50, 12, ES_AUTOHSCROLL | ES_CENTER

    LTEXT           "Audio Thread Priority:", -1, 14, 106, 106, 10
    COMBOBOX        IDC_COMBO_RULE_PRIO, 122, 104, 85, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Note: If other threads return to the audio core, status becomes Half-Isolated.\nAudio priority is auto-promoted by 1 step, keeping intruder threads 1 level below it.", 
                    IDC_STATIC_HALF_ISOLATED_NOTE, 14, 124, 254, 20

    DEFPUSHBUTTON   "OK", IDC_BTN_RULE_OK, 172, 152, 45, 15
    PUSHBUTTON      "Cancel", IDC_BTN_RULE_CANCEL, 223, 152, 45, 15
END

// Sort Confirmation Dialog (Minimum Height, No Text Area)
IDD_SORT_CONFIRM DIALOGEX 0, 0, 110, 36
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SORT?"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 12, 11, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 58, 11, 40, 14
END

// Tray Context Menu
IDR_TRAY_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Open Settings", ID_TRAY_OPEN
        MENUITEM "Start with Windows", ID_TRAY_STARTUP
        MENUITEM SEPARATOR
        MENUITEM "Restart", ID_TRAY_RESTART
        MENUITEM "Restart as Administrator", ID_TRAY_RESTART_ADMIN
        MENUITEM "Exit", ID_TRAY_EXIT
    END
END

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,4,0
PRODUCTVERSION  1,0,4,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Audio Thread Isolator\0"
            VALUE "FileVersion",      "1.0.4.0\0"
            VALUE "InternalName",     "ATI\0"
            VALUE "OriginalFilename", "ATI.exe\0"
            VALUE "ProductName",      "Audio Thread Isolator\0"
            VALUE "ProductVersion",   "1.0.4\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

